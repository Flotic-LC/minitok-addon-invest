FROM node:20-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      tzdata docker.io git openssh-client ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/share/zoneinfo/Asia/Seoul /etc/localtime && \
    echo "Asia/Seoul" > /etc/timezone

# Create non-root admin user
RUN groupadd -g 988 docker 2>/dev/null || true
RUN useradd -m -u 1001 -s /bin/bash -G docker admin

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install --omit=dev
RUN npm install -g cline

COPY admin.js ./
COPY src ./src

# Init git with real remote history so cline commits can push as fast-forwards
RUN cd /app && git init -q && \
    git remote add origin https://github.com/Flotic-LC/minitok-addon-invest.git && \
    git fetch origin && \
    git reset --hard origin/master && \
    git config user.email "admin-bot@minitok" && \
    git config user.name "minitok-admin-bot"

RUN chown -R admin:admin /app

ENV TZ=Asia/Seoul
ENV NODE_ENV=production
ENV HOME=/home/admin

USER admin
CMD ["node", "admin.js"]
