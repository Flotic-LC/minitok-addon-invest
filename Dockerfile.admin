FROM node:20-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      tzdata docker.io git openssh-client ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/share/zoneinfo/Asia/Seoul /etc/localtime && \
    echo "Asia/Seoul" > /etc/timezone

# Create non-root admin user
RUN groupadd -g 988 docker 2>/dev/null || true
RUN useradd -m -u 1001 -s /bin/bash -G docker admin

WORKDIR /app

# Clone the repository (provides code + real git history for cline changes)
RUN git clone https://github.com/Flotic-LC/minitok-addon-tossinvest.git . ; echo "CLONE_EXIT=$?"; ls -la /app | head -8

RUN npm install --omit=dev
RUN npm install -g cline

RUN chown -R admin:admin /app

ENV TZ=Asia/Seoul
ENV NODE_ENV=production
ENV HOME=/home/admin

USER admin
RUN git config user.email "admin-bot@minitok" && git config user.name "minitok-admin-bot"

CMD ["node", "admin.js"]
