# minitok-invest environment (copy to .env and fill secrets; chmod 0600)
# secrets — NEVER commit real values
WTS_UTK=
WTS_XSRF=

# persistence (all under /app/state durable volume)
STATE_DIR=/app/state
STORE_DIR=/app/state/events
TRADING_MEMORY_DIR=/app/state/.memory
KNOWLEDGE_PATH=/app/state/.knowledge.json
METRICS_PATH=/app/state/.metrics.json
AUDIT_DIR=/app/state/.audit
INTEL_STATE_PATH=/app/state/.intelligence-state.json

# optional toggles
AUDIT_LOG_ENABLED=true
METRICS_DUMP_INTERVAL_MS=60000
INTEL_NEWS_API_KEY=
INTEL_FRED_API_KEY=
WEB_SEARCH_ENABLED=true
MARKET_INTEL_ENABLED=true
INTEL_NEWS_ENABLED=true
CONFIDENCE_SAMPLES=1
JP_DATA_ENABLED=false

# capital utilization
MAX_ORDER_VALUE_KRW=5000000
EXPO_MIN_CASH_RESERVE_PCT=15
SIZE_RISK_PCT=1.0
SIZE_EQUITY_PCT=4

# confidence thresholds (restore defaults)
CONFIDENCE_MIN_THRESHOLD=0.40
CONFIDENCE_SKIP_THRESHOLD=0.20
META_COG_THRESHOLD=0.55
