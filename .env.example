# minitok-invest environment (copy to .env and fill secrets; chmod 0600)
# secrets — NEVER commit real values
WTS_UTK=
WTS_XSRF=

# persistence (all under /app/state durable volume)
STATE_DIR=/app/state
STORE_DIR=/app/state/events
TRADING_MEMORY_DIR=/app/state/.memory
KNOWLEDGE_PATH=/app/state/.knowledge.json
METRICS_PATH=/app/state/.metrics.json
AUDIT_DIR=/app/state/.audit
INTEL_STATE_PATH=/app/state/.intelligence-state.json

# optional toggles
AUDIT_LOG_ENABLED=true
METRICS_DUMP_INTERVAL_MS=60000
INTEL_NEWS_API_KEY=
INTEL_FRED_API_KEY=
WEB_SEARCH_ENABLED=true
MARKET_INTEL_ENABLED=true
INTEL_NEWS_ENABLED=true
CONFIDENCE_SAMPLES=1
JP_DATA_ENABLED=false

# FX auto-exchange (alert = notify only, execute = auto convert USD->KRW)
AUTO_EXCHANGE_MODE=alert

# UNLIMIT_MODE: DANGEROUS — removes max-order-value safety cap. Leave false/unset.
# UNLIMIT_MODE=false

# --- Core trading ---
DRY_RUN=true
WATCH_SYMBOLS=
MAX_UNIVERSE_SIZE=50
POLL_INTERVAL_MS=45000
AI_THROTTLE_MS=
WS_THROTTLE_MS=60000
AI_CACHE_TTL_MS=25000
AI_MAX_PROFIT_PCT=0
ORDER_COOLDOWN_MS=5000
MAX_OPEN_ORDERS=10
MAX_POSITIONS_PER_SYMBOL=1
DAILY_MAX_VALUE_KRW=5000000

# --- LLM providers ---
PROFUNDO_API_KEY=
PROFUNDO_BASE_URL=https://api.profundoai.com/v1
PROFUNDO_MODEL=gpt-6-astra
BRAVE_SEARCH_API_KEY=
AIFROMU_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Risk / stops ---
SYMBOL_MAX_LOSS_PCT=-12
TAKE_PROFIT_PCT=12
TRAILING_STOP_PCT=-8
TRAILING_STOP_MIN_PROFIT_PCT=3
ATR_HARD_STOP_MULT=2
CROSS_ASSET_GUARD_THRESHOLD=3.0
ATR_HARD_STOP_MULT=2

# --- Discovery ---
DISCOVERY_MIN_PRICE=1000
DISCOVERY_INTERVAL_MS=1800000

# --- Evolution / walk-forward ---
EVOLUTION_ENABLED=true
EVOLUTION_FAIL_CLOSED=true
EVOLUTION_INTERVAL_HOURS=24
WALK_FORWARD_ENABLED=true
WF_TRAIN_BARS=150
WF_TEST_BARS=30
WF_STEP_BARS=30

# --- Sidecar ---
SIDECAR_URL=http://sidecar:8471

# --- State paths (all under durable volume) ---
STATE_DIR=/app/state

# capital utilization
MAX_ORDER_VALUE_KRW=5000000
EXPO_MIN_CASH_RESERVE_PCT=15
SIZE_RISK_PCT=1.0
SIZE_EQUITY_PCT=4

# confidence thresholds (restore defaults)
CONFIDENCE_MIN_THRESHOLD=0.40
CONFIDENCE_SKIP_THRESHOLD=0.20
META_COG_THRESHOLD=0.55
